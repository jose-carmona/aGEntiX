# ==============================================================================
# Configuración del Back-Office de Agentes IA - aGEntiX
# ==============================================================================
#
# IMPORTANTE:
# - Copiar este archivo a .env y ajustar los valores
# - NUNCA commitear el archivo .env (está en .gitignore)
# - Usar valores seguros en producción
#
# ==============================================================================

# ------------------------------------------------------------------------------
# JWT - Autenticación y Seguridad
# ------------------------------------------------------------------------------

# Secret para firmar/verificar tokens JWT
# PRODUCCIÓN: Generar con: openssl rand -hex 32
JWT_SECRET=change-me-in-production-use-openssl-rand

# Algoritmo de firma JWT
JWT_ALGORITHM=HS256

# ------------------------------------------------------------------------------
# JWT - Validación de Claims
# ------------------------------------------------------------------------------

# Emisor esperado del token (quien genera el JWT)
JWT_EXPECTED_ISSUER=agentix-bpmn

# Subject esperado (tipo de ejecución)
JWT_EXPECTED_SUBJECT=Automático

# Audiencia requerida (a qué MCP va dirigido)
JWT_REQUIRED_AUDIENCE=agentix-mcp-expedientes

# ------------------------------------------------------------------------------
# MCP - Model Context Protocol
# ------------------------------------------------------------------------------

# Ruta al archivo de configuración de servidores MCP
MCP_CONFIG_PATH=src/backoffice/config/mcp_servers.yaml

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------

# Nivel de logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Directorio para logs de ejecución de agentes
LOG_DIR=logs/agent_runs

# ------------------------------------------------------------------------------
# Admin Authentication (Paso 3 - Dashboard Frontend)
# ------------------------------------------------------------------------------

# Token de administración para acceso al dashboard web
# PRODUCCIÓN: Generar con: python -c "import secrets; print(secrets.token_urlsafe(32))"
# DESARROLLO: Usar un valor simple para testing
API_ADMIN_TOKEN=agentix-admin-dev-token-2024

# ------------------------------------------------------------------------------
# Agentes IA (Paso 6 - CrewAI)
# ------------------------------------------------------------------------------

# Ruta al archivo de configuración de agentes
AGENTS_CONFIG_PATH=src/backoffice/config/agents.yaml

# API Key de Anthropic para agentes CrewAI
# PRODUCCIÓN: Obtener en https://console.anthropic.com/
# DESARROLLO: Dejar vacío o usar key de prueba
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# Frontend (Vite) - Variables con prefijo VITE_ son expuestas al cliente
# ------------------------------------------------------------------------------

# URL del backend API
VITE_API_URL=http://localhost:8080

# URL del servidor MCP
VITE_MCP_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Redis (Paso 12 - Escalado Horizontal)
# ------------------------------------------------------------------------------

# Host del servidor Redis
REDIS_HOST=localhost

# Puerto del servidor Redis
REDIS_PORT=6379

# Base de datos Redis (0-15)
REDIS_DB=0

# Password de Redis (vacío para desarrollo local)
# PRODUCCIÓN: Configurar password seguro
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# Celery (Paso 12 - Escalado Horizontal)
# ------------------------------------------------------------------------------

# URL del broker Celery (Redis)
CELERY_BROKER_URL=redis://localhost:6379/0

# URL del backend de resultados Celery (Redis)
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Tiempo límite por tarea en segundos (1 hora por defecto)
CELERY_TASK_TIME_LIMIT=3600

# Registrar inicio de tareas para monitoreo
CELERY_TASK_TRACK_STARTED=true

# ------------------------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------------------------

# Usar Celery para ejecución de agentes (Paso 12)
# false = BackgroundTasks (actual), true = Celery (distribuido)
USE_CELERY=false

# ==============================================================================
# Notas de Seguridad
# ==============================================================================
#
# 1. JWT_SECRET:
#    - Debe ser único por entorno
#    - Mínimo 32 caracteres
#    - Rotar periódicamente (cada 90 días recomendado)
#    - Usar secretos diferentes en dev/staging/prod
#
# 2. Gestión de Secretos:
#    - Producción: Usar gestor de secretos (AWS Secrets Manager, Vault, etc.)
#    - No compartir secretos por email/chat
#    - Documentar política de rotación
#
# 3. Validación JWT:
#    - Los valores de issuer/subject/audience deben coincidir con el BPMN
#    - Cambiar estos valores requiere coordinación con el sistema BPMN
#
# ==============================================================================
